ANTHROPIC_API_KEY=

# Claim path (extraction + coding). Sonnet until the eval suite has been run on
# real demo encounters and can say what the coding actually costs in accuracy.
ANTHROPIC_MODEL=claude-sonnet-5

# Transcript cleanup only -- punctuation repair, not judgment. Regenerates the
# whole transcript as output tokens, so it stays cheap.
ANTHROPIC_UTILITY_MODEL=claude-haiku-4-5

# Stedi sandbox submission (837P claims). Test-mode key from
# stedi.com/create-sandbox -- test keys only reach Stedi's sandbox network.
STEDI_API_KEY=

# Notion-backed persistence (demo only -- synthetic data only, see
# src/repository/Repository.js). An internal integration token from
# notion.so/my-integrations, shared with the "Ruby App Data" page and its
# child databases. Data source IDs (not database IDs) come from the
# `collection://<id>` URL the Notion API/MCP shows for each database.
NOTION_API_KEY=
NOTION_PATIENTS_DATA_SOURCE_ID=
NOTION_CASES_DATA_SOURCE_ID=
NOTION_ENCOUNTERS_DATA_SOURCE_ID=
NOTION_ARTIFACTS_DATA_SOURCE_ID=
NOTION_CLAIMS_DATA_SOURCE_ID=
NOTION_DOCUMENTS_DATA_SOURCE_ID=

# The Notion "Data Model" page -- the readable mirror of docs/data/, replaced
# wholesale by scripts/publish-data-model.js. Not a secret; access is controlled
# by NOTION_API_KEY, which must be shared with this page as well as the
# databases above. Only needed to publish; the app never reads it.
NOTION_DATA_MODEL_PAGE_ID=3da4b1e5-9617-81a1-bedb-efab9e89be14

# The Notion "Data Model Audits" database -- one row per run of the data-model
# agent, filed by scripts/record-audit-run.js from the <!-- audit-meta --> block
# the agent leaves in docs/data/schema-audit.md. Not a secret; the same
# NOTION_API_KEY must be shared with this database too. Only needed to file a
# run; the app never reads it. Named in full rather than the shorter
# NOTION_AUDIT_LOG_... because that belongs to the app's own Audit Log database
# and silently pointed this script at it.
NOTION_DATA_MODEL_AUDITS_DATA_SOURCE_ID=8970790a-d157-47af-bc8a-3aa6542960c0

# Payer Feedback -- what comes back after a claim is submitted (277CA
# acknowledgments, 835 remittances). Added with the denial loop, and optional:
# without it the app runs exactly as before and only the denial features
# report that they are not configured.
NOTION_PAYER_FEEDBACK_DATA_SOURCE_ID=

# Where LocalDiskBlobStore writes files (see src/repository/LocalDiskBlobStore.js).
# Defaults to backend/data/blobs if unset -- same ephemeral-disk caveat as
# provider profiles. Only needed to override the default.
BLOB_STORE_DIR=

PORT=3000
