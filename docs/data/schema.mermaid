erDiagram

    %% Ruby Health -- data model ERD
    %% Generated by the `data-model` agent (.claude/agents/data-model.md).
    %% Regenerated on each run; do not hand-edit -- edit the source and re-run.
    %% Source: backend/src/repository/NotionRepository.js (parse*/create* pairs).
    %%         NotionRepository.js is byte-for-byte unchanged since the last run
    %%         (commit f56be4c); the P2 pipeline merge that landed in dcf9707
    %%         changed how artifacts are produced, not the store's shape.
    %% Commit: dcf9707
    %% Mode:   code-derived. Live Notion was NOT reachable this run: the
    %%         notion-fetch / notion-search tools are absent from this session,
    %%         and a direct API probe returned HTTP 401 with no way to supply a
    %%         valid token (the credential is sandbox-blocked). So property names,
    %%         types and select option lists below are what the repository writes
    %%         and reads -- not a verified live schema. Where the 2026-09-19 live
    %%         run recorded an option the code does not declare, that is noted.
    %% Store:  Notion databases, one per entity. Types below are Notion property
    %%         types, not SQL types. `title` is the Notion title property.
    %% Note:   every FK is soft -- plain rich_text, not a Notion relation. Nothing
    %%         enforces that a referenced row exists or still exists.
    %% Note:   `created_at` was a real created_time property on Patients only as
    %%         of the last live run. Every other parser falls back to the Notion
    %%         page's own created_time, so it is shown as implicit.

    PATIENT ||--o{ CASE : "has"
    PATIENT ||--o{ ENCOUNTER : "denormalized onto"
    PATIENT ||--o{ DOCUMENT : "has"
    CASE ||--o{ ENCOUNTER : "contains"
    CASE |o--o{ DOCUMENT : "may scope"
    ENCOUNTER ||--o{ ARTIFACT : "versioned output of"
    ENCOUNTER ||--o{ CLAIM : "billed as"
    ARTIFACT ||--o{ CLAIM : "built from"
    CLAIM |o--o{ CLAIM : "amended by"
    CLAIM ||--o{ PAYER_FEEDBACK : "answered by"
    CLAIM ||--o{ AUDIT_LOG : "acted on by"
    ARTIFACT ||--o{ AUDIT_LOG : "acted on by"
    PROVIDER_PROFILE ||--o{ CLAIM : "billed for"
    PROVIDER_PROFILE ||--o{ ARTIFACT : "created for"
    PROVIDER_PROFILE ||--o{ AUDIT_LOG : "acted as"

    PATIENT {
        title patient_id PK
        rich_text name "PHI; read first-item-only, and it is how the placeholder patient is found"
        date date_of_birth "PHI; reaches the claim's subscriber block. No update path exists"
        select sex "PHI; male | female | unknown -- omitted when not recorded; populateClaim maps to M/F/U"
        select insurance_status "PHI-adjacent; self_pay | insured | pending -- a snapshot, and nothing can change it"
        created_time created_at "the only entity with a real created_time property"
    }

    CASE {
        title case_id PK
        rich_text patient_id FK
        rich_text case_title "domain field is `title`; see SCHEMA.md"
        select status "open | closed -- literal at both write sites, no repository constant"
        date opened_at "set from the server clock at create time"
        date closed_at "null while open"
        created_time created_at "implicit page.created_time; parseCase is the one parser that does not expose it"
    }

    ENCOUNTER {
        title encounter_id PK
        rich_text case_id FK
        rich_text patient_id FK "denormalized from the case, never caller-supplied"
        date occurred_at "the real date of service; read into the claim via buildClaimContext"
        select status "draft written at create, submitted written after a claim goes out; endpoint also accepts reviewed; no repository constant, unvalidated on write"
        created_time created_at "implicit page.created_time"
    }

    ARTIFACT {
        title artifact_id PK
        rich_text encounter_id FK
        select stage "transcript | facts | codes | claim | submission -- submission is the 837P as sent; no appeal stage"
        number version "auto-incremented per (encounter_id, stage); not atomic"
        rich_text content "JSON blob, chunked at 2000 chars; ~100 chunk ceiling, unguarded. facts blob carries an undeclared medicalNecessityGrounding key; codes blob carries validation verdicts"
        select created_by "system | provider_edit -- no person behind either, and no model identity"
        rich_text provider_id FK "soft FK to the provider profile JSON file; empty string when unknown"
        created_time created_at "implicit page.created_time"
    }

    CLAIM {
        title claim_id PK "also sent to the payer as CLP01 on every submission path"
        rich_text encounter_id FK
        rich_text artifact_id FK "the artifact this claim was built from; written but never read back -- no repository method resolves an artifact by id"
        select claim_type "original | corrected | secondary -- appeals are filed as corrected"
        rich_text parent_claim_id FK "self; empty string when none"
        rich_text payer_name "always the populateClaim literal; no Payer entity exists"
        rich_text member_id "PHI slot; always the populateClaim placeholder; no Coverage entity exists"
        select status "draft | submitted | accepted | rejected | denied | pending"
        date submitted_at "set from the server clock on transition to submitted"
        rich_text payer_claim_control_number "payer-assigned; arrives on 277CA or 835"
        number billed_amount "total charge on the 837P as sent; null until sent"
        rich_text provider_id FK "soft FK to the provider profile JSON file; a correction inherits the original's"
        created_time created_at "implicit page.created_time"
    }

    PAYER_FEEDBACK {
        title feedback_id PK
        rich_text claim_id FK "reconciled against the 835's own CLP01 before filing"
        select feedback_type "acknowledgment | remittance"
        date received_at
        rich_text payer_claim_control_number "payer-assigned"
        select claim_status "sourced from parseRemittance; no repository constant, unvalidated on write"
        select recommended_route "sourced from analyzeRemittance; no repository constant, unvalidated on write"
        number amount_at_risk "Notion dollar format; no currency code stored"
        rich_text storage_ref "points at BlobStore on ephemeral disk, not Notion"
        rich_text content "JSON blob; the only home for billed, paid and both deadlines"
        created_time created_at "implicit page.created_time"
    }

    AUDIT_LOG {
        title log_id PK "minted by scanning every existing log row; the fastest-growing table"
        rich_text provider_id FK "the actor, taken from the request body and never verified"
        select entity_type "claim | artifact -- cannot name a patient, case, encounter or payer document"
        rich_text entity_id FK "polymorphic, resolved by entity_type; empty when the write it describes failed first"
        select action "created | edited | status_changed | submitted | approved -- the last two are declared, never written"
        rich_text detail "free text, chunked; carries the encounter and stage when entity_id is empty"
        created_time created_at "implicit page.created_time"
    }

    DOCUMENT {
        title document_id PK
        rich_text patient_id FK
        rich_text case_id FK "optional; empty string when unscoped"
        select source "upload | fax | ehr_sync"
        date document_date
        rich_text storage_ref "points at BlobStore on ephemeral disk, not Notion"
        select extraction_status "only none is ever written; no repository constant"
        created_time created_at "implicit page.created_time"
    }

    %% Not a Notion database: a JSON file on ephemeral disk
    %% (backend/src/providerProfiles.js), keyed by providerId. Claim, Artifact
    %% and Audit Log rows point at it, but the target of those FKs does not
    %% survive a redeploy, and upsert overwrites in place with no version.
    PROVIDER_PROFILE {
        json_file provider_id PK "every row written today says `default`"
        json_file name "the clinician"
        json_file organization "optional; the billing entity the payer sees, falls back to name"
        json_file npi "10 digits, validated on upsert"
        json_file ein "optional; 9 digits; becomes the 837P employerId"
        json_file ssn "optional; sensitive; documented but read by nothing"
        json_file taxonomyCode "optional"
        json_file phone "optional"
        json_file address "nested object"
    }

    %% Not modelled anywhere at all, and asserted on every outgoing claim:
    %% the subscriber's member ID and address, the payer's name and id, and the
    %% billed charge amount (a flat 100.00 per service line invented in
    %% buildStediClaim.js). None of these has a row, a column or a file.
    %% Subscriber name, date of birth and sex now come from the Patient row.

    %% Computed by the pipeline and stored nowhere: the whole appeal draft
    %% except its letter body (draftAppeal.js -- denialAssessment,
    %% worthAppealing, recommendedAction, supportingQuotes, quoteGrounding,
    %% suggestedCodeChanges); the 837P payload actually transmitted; and, new in
    %% the P2 merge, the reviewer brief (cleanupTranscript.js/generateBrief),
    %% which used to rewrite the transcript and now produces a summary with no
    %% home in the schema.

    %% Written to Notion but outside the Repository seam entirely: the "Data
    %% Model Audits" database (backend/scripts/record-audit-run.js), which files
    %% one row per run of this agent. Tooling, not product data -- no entity here.
